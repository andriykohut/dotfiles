# The repository root is ~/.config, which every installed tool writes into --
# including credentials. Ignore everything, then opt in explicitly, so tool
# state can never be committed by accident.
/*

!/.gitignore
!/Brewfile
!/Brewfile.local.example
!/bootstrap.sh
!/README.md
!/install.sh
!/home/
!/ghostty/
!/nvim/
!/workmux/
